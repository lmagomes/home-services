[Unit]
Description=Dev environment container managed by Podman
After=network.target

[Container]
Pod=dev.pod
ContainerName=dev
Image=home-services/dev:44-r8
Secret=dev-opencode-server-password,type=env,target=OPENCODE_SERVER_PASSWORD
Secret=dev-ssh-pubkey,type=env,target=DEV_SSH_PUBKEY
Secret=dev-ssh-private-key,type=env,target=DEV_SSH_PRIVATE_KEY
Secret=dev-sops-age-key,target=/run/secrets/sops-age-key,mode=0600
Volume=dev-home.volume:/home/dev:Z
EnvironmentFile=./%N.env

[Service]
Restart=on-failure

[Install]
WantedBy=multi-user.target
