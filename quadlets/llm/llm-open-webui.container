[Unit]
Description=open-webui container managed by Podman
After=network.target

[Container]
ContainerName=llm-open-webui
Pod=llm.pod
Image=ghcr.io/open-webui/open-webui:v0.9.5
Volume=llm-open-webui-data.volume:/app/backend/data:Z
EnvironmentFile=./%N.env
Secret=llm-open-webui-client-id,type=env,target=OAUTH_CLIENT_ID
Secret=llm-open-webui-client-secret,type=env,target=OAUTH_CLIENT_SECRET
Secret=llm-open-webui-provider-url,type=env,target=OPENID_PROVIDER_URL
Secret=llm-open-webui-redirect-url,type=env,target=OPENID_REDIRECT_URI
Secret=llm-open-webui-url,type=env,target=WEBUI_URL

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
