[Unit]
Description=llamacpp container managed by Podman
After=network.target

[Container]
ContainerName=llamacpp
Pod=llm.pod
Image=ghcr.io/ggml-org/llama.cpp:server-vulkan-b7973
Volume=llm-llamacpp-models.volume:/models:Z
AddDevice=/dev/dri
EnvironmentFile=./%n.d/env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target