[Unit]
Description=ollama container managed by Podman
After=network.target

[Container]
ContainerName=ollama
Pod=llm.pod
Image=docker.io/ollama/ollama:0.16.2
Volume=ollama-data.volume:/root/.ollama:Z
AddDevice=/dev/dri
EnvironmentFile=./%n.d/env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target