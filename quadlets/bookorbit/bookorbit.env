TZ=Europe/Lisbon
PUID=1000
PGID=1000
POSTGRES_HOST=bookorbit-db
POSTGRES_PORT=5432
POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
#POSTGRES_PASSWORD is set via Secret in the .container file
#JWT_SECRET is set via Secret in the .container file
#SETUP_BOOTSTRAP_TOKEN is set via Secret in the .container file
#APP_URL is set via Secret in the .container file
#PODCAST_ENCRYPTION_KEY is set via Secret in the .container file
NODE_MAX_OLD_SPACE_SIZE=2048
LIBRARY_BROWSE_ROOT=/books
LOG_LEVEL=info
