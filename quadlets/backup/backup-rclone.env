# Timezone
TZ=Europe/Lisbon

# Rclone config is stored in the backup-rclone-config volume at /config/rclone
# To configure the protondrive remote, run:
#   podman run -it --rm -v backup-rclone-config:/config/rclone docker.io/rclone/rclone:1.71 config
# This will create/update /config/rclone/rclone.conf
