[Unit]
Description=proton drive sync container managed by Podman
After=network.target

[Container]
ContainerName=backup-proton-drive-sync
Pod=backup.pod
Image=home-services/proton-drive-sync:v0.2.4
EnvironmentFile=./%N.env

# Overrides for debugging: keep the container alive
# Entrypoint=sleep
# Exec=infinity

Volume=backup-proton-drive-sync-config.volume:/config/proton-drive-sync
Volume=backup-proton-drive-sync-state.volume:/state/proton-drive-sync
Mount=type=bind,source=/mnt/nas/backup/podman-volumes,destination=/data/podman-volumes-backup,relabel=private
Secret=proton-drive-sync-keyring-password,type=env,target=KEYRING_PASSWORD

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
