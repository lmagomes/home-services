[Unit]
Description=Backup restic oneshot container
After=network-online.target

[Container]
ContainerName=backup-restic
Pod=backup.pod
Image=home-services/backup-restic:44-r1

# Podman socket for stopping/starting pods and exporting volumes
Mount=type=bind,source=/run/user/1000/podman/podman.sock,destination=/run/user/1000/podman/podman.sock,relabel=private
Environment=XDG_RUNTIME_DIR=/run/user/1000

# Tarball export destination
Mount=type=bind,source=%h/podman_volume_backup,destination=/data/podman-volume-backup,relabel=private

# Restic repos on NAS
Mount=type=bind,source=/mnt/nas/backup/podman-volumes,destination=/data/restic/podman-volumes,relabel=private
Mount=type=bind,source=/mnt/nas/backup/books,destination=/data/restic/books,relabel=private
Mount=type=bind,source=/mnt/nas/backup/audiobooks,destination=/data/restic/audiobooks,relabel=private

# Media sources for restic backup
Mount=type=bind,source=/mnt/nas/media/books,destination=/data/media/books,relabel=private
Mount=type=bind,source=/mnt/nas/media/audiobooks,destination=/data/media/audiobooks,relabel=private

Secret=restic-password,type=env,target=RESTIC_PASSWORD

[Service]
Type=oneshot
RemainAfterExit=yes

# No [Install] - only triggered by timer
