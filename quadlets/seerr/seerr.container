[Unit]
Description=Seerr container managed by Podman
After=network.target

[Container]
ContainerName=seerr
Pod=seerr.pod
Image=ghcr.io/seerr-team/seerr:v3.4.1
Volume=seerr-config.volume:/app/config:nocopy,Z
EnvironmentFile=./%N.env
HealthCmd=["wget","--no-verbose","--tries=1","--spider","http://localhost:5055/api/v1/settings/public"]
HealthInterval=15s
HealthTimeout=3s
HealthStartPeriod=20s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
