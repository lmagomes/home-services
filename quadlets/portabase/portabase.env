#DATABASE_URL is set via Secret in the .container file
# (postgresql://portabase:<password>@localhost:5432/portabase?schema=public)
#PROJECT_SECRET is set via Secret in the .container file
#PROJECT_URL is set via Secret in the .container file
#TRUSTED_DOMAINS is set via Secret in the .container file
TZ=UTC
PORT=80
AUTH_OIDC_ID=authentik
AUTH_OIDC_TITLE=Authentik
AUTH_OIDC_DESC=Sign in with Authentik
AUTH_OIDC_SCOPES=openid profile email
AUTH_OIDC_PKCE=true
ALLOWED_GROUP=portabase-users
AUTH_ALLOW_LINKING=true
AUTH_ALLOW_UNLINKING=true
AUTH_SYNC_OIDC_ROLES_ON_LOGIN=true
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_SIGNUP_ENABLED=true
AUTH_PASSKEY_ENABLED=true
#AUTH_OIDC_CLIENT is set via Secret in the .container file
#AUTH_OIDC_SECRET is set via Secret in the .container file
#AUTH_OIDC_ISSUER_URL is set via Secret in the .container file
