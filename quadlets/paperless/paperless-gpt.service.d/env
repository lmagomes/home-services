PAPERLESS_BASE_URL=http://paperless-ngx:8001
# PAPERLESS_API_TOKEN=token
# PAPERLESS_PUBLIC_URL=http://paperless.mydomain.com # Optional

LLM_PROVIDER=openai
LLM_MODEL=gemma-3-4b-it-Q4_K_M
OPENAI_API_KEY=dummy-key
OPENAI_BASE_URL=http://llm.pod:10000/v1
# Recommended for smaller models
TOKEN_LIMIT=1000

# Optional, default=English
LLM_LANGUAGE=English

# Default OCR provider
OCR_PROVIDER=llm
# openai, ollama, mistral, or anthropic
VISION_LLM_PROVIDER=openai
# using the same llm model for vision
VISION_LLM_MODEL=minicpm-v-4_5-Q4_K_M

AUTO_OCR_TAG=paperless-gpt-ocr-auto
AUTO_TAG=paperless-gpt-auto
MANUAL_TAG=paperless-gpt-manual
PDF_OCR_TAGGING=true
PDF_OCR_COMPLETE_TAG=paperless-gpt-ocr-complete
PDF_UPLOAD=false

LOG_LEVEL=INFO

