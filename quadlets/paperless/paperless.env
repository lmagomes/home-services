TZ=Europe/Lisbon
PAPERLESS_REDIS=redis://paperless-redis:6379
PAPERLESS_DBHOST=paperless-postgres
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
# PAPERLESS_DBPASS=paperless
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://paperless-gotenberg:3001
PAPERLESS_TIKA_ENDPOINT=http://paperless-tika:9998s

# PAPERLESS_URL=https://paperless.some.domain

PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
# PAPERLESS_SOCIALACCOUNT_PROVIDERS=value
# PAPERLESS_LOGOUT_REDIRECT_URL=https://authentik.some.domain/application/o/paperless/end-session/
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=true
PAPERLESS_PORT=8001

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_MODEL=gemma-3-4b-it-Q4_K_M
PAPERLESS_AI_LLM_ENDPOINT=http://llm.pod:10000/v1
PAPERLESS_AI_LLM_API_KEY=dummy-key
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=huggingface
PAPERLESS_AI_LLM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAPERLESS_AI_LLM_CONTEXT_SIZE=4096
PAPERLESS_AI_LLM_REQUEST_TIMEOUT=300
