[Unit]
Description=Invidious PostgreSQL Database

[Container]
ContainerName=invidious-db
Pod=youtube.pod
Image=docker.io/postgres:18.1
EnvironmentFile=./%n.d/env
Secret=invidious-db-password,type=env,target=POSTGRES_PASSWORD
Volume=invidious-db-data.volume:/var/lib/postgresql:Z

HealthCmd=pg_isready -U $POSTGRES_USER -d $POSTGRES_DB
HealthStartupCmd=pg_isready -U $POSTGRES_USER -d $POSTGRES_DB

LogDriver=journald

[Install]
WantedBy=default.target
