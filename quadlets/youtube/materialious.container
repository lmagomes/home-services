[Unit]
Description=Materialious

[Container]
ContainerName=materialious
Pod=youtube.pod
Image=docker.io/wardpearce/materialious-full:latest
EnvironmentFile=./%n.d/env
Secret=materialious-cookie-secret,type=env,target=COOKIE_SECRET
Secret=materialious-default-invidious-instance,type=env,target=PUBLIC_DEFAULT_INVIDIOUS_INSTANCE
Secret=materialious-whitelist-base-domain,type=env,target=WHITELIST_BASE_DOMAIN
Volume=materialious-data.volume:/materialious-data:Z

[Install]
WantedBy=default.target
