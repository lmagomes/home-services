# =============================================================================
# RustFS Environment Configuration
# =============================================================================

# Timezone
TZ=Europe/Lisbon

# S3 API (internal) and console (web UI) listen addresses
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true

# Data directory (persistent volume)
RUSTFS_VOLUMES=/data

# Log level; empty log directory routes logs to stdout (journald)
RUSTFS_OBS_LOGGER_LEVEL=info
RUSTFS_OBS_LOG_DIRECTORY=

# RUSTFS_ACCESS_KEY is set via Secret in the .container file
# RUSTFS_SECRET_KEY is set via Secret in the .container file
