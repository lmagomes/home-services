# These env vars are for the daemon process's container backend.
# The daemon uses DOCKER_HOST (Unix socket) set in the .container file.
# Jobs receive SSH settings via runner.envs in forgejo-runner-config.yml instead.
# CONTAINER_HOST=ssh://forgejo-runner@<host-ip-or-hostname>
# CONTAINER_SSHKEY=/etc/ssh/forgejo-runner-key
