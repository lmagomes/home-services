[Unit]
Description=Forgejo Runner container managed by Podman
After=network-online.target

[Container]
Pod=forgejo-runner.pod
ContainerName=forgejo-runner
Image=data.forgejo.org/forgejo/runner:12
User=0:0
SecurityLabelDisable=true
Environment=DOCKER_HOST=unix://%t/podman/podman.sock
Environment=XDG_RUNTIME_DIR=%t
Volume=forgejo-runner-data.volume:/data:Z
Volume=./%N-config.yml:/data/config.yml:ro,Z
Mount=type=bind,source=%t/podman/podman.sock,destination=%t/podman/podman.sock
Exec=/bin/forgejo-runner daemon --config /data/config.yml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
