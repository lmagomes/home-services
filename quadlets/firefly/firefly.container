[Unit]
Description=Firefly main container managed by Podman
After=network.target firefly-db.service

[Container]
ContainerName=firefly
Pod=firefly.pod
Image=docker.io/fireflyiii/core:version-6.6.2
EnvironmentFile=./%n.env
Secret=firefly-db-password,type=env,target=DB_PASSWORD
Secret=firefly-app-url,type=env,target=APP_URL
Volume=firefly-upload.volume:/var/www/html/storage/upload:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
