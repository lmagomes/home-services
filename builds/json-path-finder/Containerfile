# Stage 1: Build the static assets
FROM node:22-alpine AS builder
RUN apk add --no-cache git
# Enable corepack to install pnpm
RUN corepack enable pnpm

WORKDIR /app
# Clone the repository
RUN git clone --depth 1 https://github.com/joebeachjoebeach/json-path-finder.git .
# Install dependencies and build
RUN pnpm install
RUN pnpm run build

# Stage 2: Serve the static files using caddy
FROM caddy:alpine AS runner
# Copy the built assets to caddy's default directory
COPY --from=builder /app/dist /srv

EXPOSE 3030
CMD ["caddy", "file-server", "--root", "/srv", "--listen", ":3030"]
