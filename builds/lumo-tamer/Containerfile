# Stage 1: Go builder - compile static Go binary for Proton authentication
FROM golang:1.24-alpine AS go-builder
RUN apk add --no-cache git
WORKDIR /build
RUN git clone --depth 1 https://github.com/ZeroTricks/lumo-tamer.git . && \
    cd src/auth/login/go && \
    CGO_ENABLED=0 go build -o /proton-auth

# Stage 2: Node builder - install dependencies and compile TypeScript
FROM node:22-alpine AS builder
RUN apk add --no-cache git python3 py3-setuptools make g++ libc6-compat \
    cairo-dev pango-dev jpeg-dev giflib-dev librsvg-dev
WORKDIR /app
RUN git clone --depth 1 https://github.com/ZeroTricks/lumo-tamer.git .
RUN npm ci
RUN npm run build && npm prune --production

# Stage 3: Runner
FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/config.defaults.yaml ./
COPY --from=go-builder /proton-auth ./dist/proton-auth
RUN npm link
EXPOSE 3003
ENTRYPOINT ["sh", "-c", "case \"$1\" in auth) shift; exec tamer auth \"$@\" ;; server) shift; exec tamer server \"$@\" ;; cli) shift; exec tamer \"$@\" ;; '') exec tamer server ;; *) exec \"$@\" ;; esac", "--"]
CMD ["server"]
