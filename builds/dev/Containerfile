FROM fedora:44

RUN dnf install -y \
    fish \
    just \
    git \
    jq \
    yq \
    openssh-server \
    curl \
    wget \
    vim \
    helix \
    tmux \
    htop \
    man-db \
    dnf-plugins-core \
    nodejs \
    npm \
    && dnf copr enable lihaohong/forgejo-cli -y \
    && dnf install forgejo-cli -y \
    && dnf copr enable atim/lazygit -y \
    && dnf install lazygit -y \
    && dnf clean all

RUN usermod -s /usr/bin/fish root && \
    mkdir -p /etc/profile.d && \
    echo 'cd /home/dev' > /etc/profile.d/dev-home.sh && \
    echo 'cd /home/dev' >> /etc/fish/config.fish

COPY sshd_config /etc/ssh/sshd_config.d/50-dev.conf
COPY entrypoint.fish /entrypoint.fish
COPY terminfo/xterm-ghostty.src /tmp/terminfo/
RUN tic -x -o /usr/share/terminfo /tmp/terminfo/xterm-ghostty.src && \
    rm -rf /tmp/terminfo
RUN chmod +x /entrypoint.fish

# Re-issue all external apps install
ARG CACHEBUST=1

RUN dnf up -y

RUN curl -fsSL https://opencode.ai/install | bash && \
    ln -sf /root/.opencode/bin/opencode /usr/local/bin/opencode

RUN curl -sSL https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64 -o /usr/local/bin/sops && \
    chmod +x /usr/local/bin/sops

RUN curl -LsSf https://github.com/atuinsh/atuin/releases/latest/download/atuin-x86_64-unknown-linux-gnu.tar.gz | tar xz -C /usr/local/bin

RUN npm install -g @earendil-works/pi-coding-agent

EXPOSE 22 3000

ENTRYPOINT ["/entrypoint.fish"]
