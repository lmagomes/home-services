FROM fedora:44

ARG CACHEBUST=1
RUN echo "cachebust=$CACHEBUST"

# chromium: full browser (not chromium-headless) so pi-web's test/browser/*.mjs
# checks have CDP and can grant notifications; installs /usr/bin/chromium-browser.
RUN dnf install -y \
    fish \
    just \
    git \
    jq \
    yq \
    openssh-server \
    curl \
    wget \
    vim \
    helix \
    tmux \
    htop \
    man-db \
    dnf-plugins-core \
    nodejs \
    npm \
    chromium \
    && dnf copr enable lihaohong/forgejo-cli -y \
    && dnf install forgejo-cli -y \
    && dnf copr enable atim/lazygit -y \
    && dnf install lazygit -y \
    && dnf clean all

RUN usermod -s /usr/bin/fish root && \
    mkdir -p /etc/profile.d && \
    echo 'cd /home/dev' > /etc/profile.d/dev-home.sh && \
    echo 'cd /home/dev' >> /etc/fish/config.fish

COPY sshd_config /etc/ssh/sshd_config.d/50-dev.conf
COPY entrypoint.fish /entrypoint.fish
COPY terminfo/xterm-ghostty.src /tmp/terminfo/
RUN tic -x -o /usr/share/terminfo /tmp/terminfo/xterm-ghostty.src && \
    rm -rf /tmp/terminfo
RUN chmod +x /entrypoint.fish

RUN dnf up -y

# pi-web: browser UI for the pi coding agent, from our self-hosted Forgejo repo.
# The clone URL is injected as the `pi-web-repo` build secret so the git host
# never lands in a tracked file; `just build-and-push` resolves it through
# `just forgejo-repo-url pi-web`.
# Pinned to a release tag; bump both the tag and build-version to roll forward.
RUN --mount=type=secret,id=pi-web-repo \
    test -s /run/secrets/pi-web-repo || { \
        echo "❌ pi-web-repo build secret is missing or empty — build with 'just build-dev'" >&2; \
        exit 1; \
    }; \
    git clone --depth 1 --branch v0.11.1 "$(cat /run/secrets/pi-web-repo)" /opt/pi-web \
        && chmod +x /opt/pi-web/server.js \
        && ln -sf /opt/pi-web/server.js /usr/local/bin/pi-web

RUN curl -sSL https://github.com/getsops/sops/releases/download/v3.13.3/sops-v3.13.3.linux.amd64 -o /usr/local/bin/sops && \
    chmod +x /usr/local/bin/sops

RUN curl -LsSf https://github.com/atuinsh/atuin/releases/latest/download/atuin-x86_64-unknown-linux-gnu.tar.gz | tar xz -C /usr/local/bin

RUN npm install -g @earendil-works/pi-coding-agent

RUN curl -fsSL https://github.com/gitpod-io/openvscode-server/releases/download/openvscode-server-v1.109.5/openvscode-server-v1.109.5-linux-x64.tar.gz \
    | tar -xz -C /usr/local/lib \
    && ln -sf /usr/local/lib/openvscode-server-v1.109.5-linux-x64/bin/openvscode-server /usr/local/bin/openvscode-server

EXPOSE 22 3000 8080

ENTRYPOINT ["/entrypoint.fish"]
